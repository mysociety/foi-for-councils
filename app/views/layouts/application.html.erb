<% content_for :head do %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
  <%= javascript_include_tag 'turbo.min', type: 'module', 'data-turbo-track': 'reload' %>
  <%= javascript_include_tag 'application', defer: true, 'data-turbo-track': 'reload' %>
<% end %>

<% content_for :proposition_header do %>
  <%= render partial: 'header' %>
<% end %>

<% content_for :after_header do %>
  <%= render partial: 'breadcrumbs' %>
<% end %>

<% content_for :content do %>
  <div id='content' role='main'><%= yield %></div>
<% end %>

<%= render template: 'layouts/hackney_template' %>
